{
  "name": "empire-tycoon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:game": "vite apps/game --host 0.0.0.0",
    "build": "npm run typecheck && vite build && vite build apps/game",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p packages/tsconfig.domain.json",
    "check:file-size": "node tools/check-file-size.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@capacitor/android": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.0"
  }
}
