{
  "name": "empire-tycoon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:game": "vite apps/game --host 0.0.0.0",
    "build": "npm run typecheck && vite build && vite build apps/game",
    "build:game": "npm run typecheck && vite build apps/game",
    "prepare:mobile": "npm run build:game && node tools/prepare-mobile.mjs",
    "test": "vitest run",
    "test:acceptance": "node --test tests/acceptance/verify.mjs",
    "typecheck": "tsc --noEmit && tsc -p packages/tsconfig.domain.json",
    "check:file-size": "node tools/check-file-size.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "axe-core": "^4.14.1",
    "playwright-core": "^1.65.1",
    "typescript": "^5.8.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.0"
  }
}
